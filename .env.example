# Copy to .env for local Compose only. Never commit the populated .env file.
# In AWS, store these values in Secrets Manager and inject them at runtime.
POSTGRES_PASSWORD=

# Cognito public identifiers plus a confidential backend OAuth client secret.
AWS_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=https://your-prefix.auth.ap-southeast-2.amazoncognito.com
APP_PUBLIC_URL=http://localhost:3000

# Local HTTP only. Keep these false only for local development; AWS must use HTTPS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Amazon SES SMTP over STARTTLS.
SPRING_MAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
