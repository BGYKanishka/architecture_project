# Copy to .env for local development. Never commit the populated .env file.
# In AWS, store these values in Secrets Manager and inject them at runtime.
POSTGRES_PASSWORD=

# IntelliJ / direct Spring Boot run (use the same password as POSTGRES_PASSWORD).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bookfair_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Cognito public identifiers plus a confidential backend OAuth client secret.
AWS_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=https://your-prefix.auth.ap-southeast-2.amazoncognito.com
APP_PUBLIC_URL=http://localhost:3000

# Local HTTP only. Keep these false only for local development; AWS must use HTTPS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Amazon SES SMTP over STARTTLS.
SPRING_MAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Amazon SQS Queue & Credentials (optional if using DefaultCredentialsProvider via ~/.aws or instance profile)
AWS_SQS_EMAIL_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
